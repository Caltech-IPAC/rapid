{
    "namespace": "rapid.v00_02",
    "name": "alert",
    "doc": "Top-level alert record",
    "version": "00.02",
    "type": "record",
    "fields": [
        {
            "name": "schemaVersion",
            "type": [
                "null",
                "string"
            ],
            "default": null,
            "doc": "Version of the alert schema used to serialize this packet"
        },
        {
            "name": "pipelineVersion",
            "type": [
                "null",
                "string"
            ],
            "default": null,
            "doc": "Version of the RAPID pipeline that produced this alert (stub)"
        },
        {
            "name": "diaSourceId",
            "type": "long",
            "doc": "Identifier for the triggering diaSource"
        },
        {
            "name": "diaSource",
            "type": "rapid.v00_02.diaSource",
            "doc": "Triggering source detection"
        },
        {
            "name": "prvDiaSources",
            "type": [
                "null",
                {
                    "type": "array",
                    "items": "rapid.v00_02.diaSource"
                }
            ],
            "default": null,
            "doc": "Previous detections of the same object within 12 months"
        },
        {
            "name": "diaObject",
            "type": [
                "null",
                "rapid.v00_02.diaObject"
            ],
            "default": null,
            "doc": "Summary object record"
        },
        {
            "name": "prvDiaForcedSources",
            "type": [
                "null",
                {
                    "type": "array",
                    "items": "rapid.v00_02.diaForcedSource"
                }
            ],
            "default": null,
            "doc": "Forced photometry history at the object position"
        },
        {
            "name": "ssMatches",
            "type": [
                "null",
                {
                    "type": "array",
                    "items": "rapid.v00_02.ssMatch"
                }
            ],
            "default": null,
            "doc": "Nearest known solar system objects within the cutout at the triggering epoch; null if association was not run, empty if none found (stub)"
        },
        {
            "name": "cutoutDifference",
            "type": [
                "null",
                "bytes"
            ],
            "default": null,
            "doc": "FITS cutout of difference image"
        },
        {
            "name": "cutoutScience",
            "type": [
                "null",
                "bytes"
            ],
            "default": null,
            "doc": "FITS cutout of science image"
        },
        {
            "name": "cutoutReference",
            "type": [
                "null",
                "bytes"
            ],
            "default": null,
            "doc": "FITS cutout of reference image"
        },
        {
            "name": "observation_reason",
            "type": [
                "null",
                "string"
            ],
            "default": null,
            "doc": "Reason for observation (e.g. survey, ToO)"
        },
        {
            "name": "target_name",
            "type": [
                "null",
                "string"
            ],
            "default": null,
            "doc": "Target name if targeted observation"
        }
    ]
}
