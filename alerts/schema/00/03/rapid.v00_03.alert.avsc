{
    "namespace": "rapid.v00_03",
    "name": "alert",
    "doc": "Top-level alert record",
    "version": "00.03",
    "type": "record",
    "fields": [
        {
            "name": "schemaVersion",
            "type": [
                "null",
                "string"
            ],
            "default": null,
            "doc": "Version of the alert schema used to serialize this packet"
        },
        {
            "name": "pipelineVersion",
            "type": [
                "null",
                "string"
            ],
            "default": null,
            "doc": "Version of the RAPID pipeline that produced this alert (stub)"
        },
        {
            "name": "diaSourceId",
            "type": "long",
            "doc": "Identifier for the triggering diaSource"
        },
        {
            "name": "diaSource",
            "type": "rapid.v00_03.diaSource",
            "doc": "Triggering source detection"
        },
        {
            "name": "prvDiaSources",
            "type": [
                "null",
                {
                    "type": "array",
                    "items": "rapid.v00_03.diaSource"
                }
            ],
            "default": null,
            "doc": "Previous detections of the same object within 12 months"
        },
        {
            "name": "diaObject",
            "type": [
                "null",
                "rapid.v00_03.diaObject"
            ],
            "default": null,
            "doc": "Summary object record"
        },
        {
            "name": "prvDiaForcedSources",
            "type": [
                "null",
                {
                    "type": "array",
                    "items": "rapid.v00_03.diaForcedSource"
                }
            ],
            "default": null,
            "doc": "Forced photometry history at the object position"
        },
        {
            "name": "ssMatches",
            "type": [
                "null",
                {
                    "type": "array",
                    "items": "rapid.v00_03.ssMatch"
                }
            ],
            "default": null,
            "doc": "Nearest known solar system objects (max 3) within the cutout radius (SS_MATCH_RADIUS_ARCSEC, ~7 arcsec) of the triggering source; null if association was not run, empty if none found"
        },
        {
            "name": "refStarMatches",
            "type": [
                "null",
                {
                    "type": "array",
                    "items": "rapid.v00_03.refMatch"
                }
            ],
            "default": null,
            "doc": "Nearest star-classified reference-catalog sources (max 3, nearest first) within REF_MATCH_RADIUS_ARCSEC of the triggering source; null if matching was not run (catalog unavailable), empty if none within the radius; a full array (3) means the neighborhood may extend beyond what is reported (crowding)"
        },
        {
            "name": "refGalaxyMatches",
            "type": [
                "null",
                {
                    "type": "array",
                    "items": "rapid.v00_03.refMatch"
                }
            ],
            "default": null,
            "doc": "Nearest galaxy-classified reference-catalog sources (max 3, nearest first) within REF_MATCH_RADIUS_ARCSEC of the triggering source; null/empty semantics as refStarMatches"
        },
        {
            "name": "cutoutDifference",
            "type": [
                "null",
                "bytes"
            ],
            "default": null,
            "doc": "FITS cutout of difference image"
        },
        {
            "name": "cutoutScience",
            "type": [
                "null",
                "bytes"
            ],
            "default": null,
            "doc": "FITS cutout of science image"
        },
        {
            "name": "cutoutReference",
            "type": [
                "null",
                "bytes"
            ],
            "default": null,
            "doc": "FITS cutout of reference image"
        },
        {
            "name": "observation_reason",
            "type": [
                "null",
                "string"
            ],
            "default": null,
            "doc": "Reason for observation (e.g. survey, ToO)"
        },
        {
            "name": "target_name",
            "type": [
                "null",
                "string"
            ],
            "default": null,
            "doc": "Target name if targeted observation"
        }
    ]
}
