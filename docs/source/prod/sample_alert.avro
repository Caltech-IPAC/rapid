 "float"]}, {"doc": "Effective mid-observation time (UTC scale) [MJD]", "name": "midpointMjd", "type": "double"}, {"doc": "Time measurement was processed (UTC scale) [MJD]", "name": "timeProcessedMjd", "type": "double"}]}}]}, {"doc": "Nearest known solar system objects (max 3) within the cutout radius (SS_MATCH_RADIUS_ARCSEC, ~7 arcsec) of the triggering source; null if association was not run, empty if none found", "default": null, "name": "ssMatches", "type": ["null", {"type": "array", "items": {"version": "00.05", "type": "record", "doc": "Known solar system object predicted near the triggering source (stub)", "name": "rapid.v00_05.ssMatch", "fields": [{"doc": "MPC designation of the solar system object", "name": "designation", "type": "string"}, {"doc": "Predicted right ascension of the object at midpointMjd; ICRS [deg]", "name": "ra", "type": "double"}, {"doc": "Predicted declination of the object at midpointMjd; ICRS [deg]", "name": "dec", "type": "double"}, {"doc": "Angular separation from the triggering source position [arcsec]", "name": "sep", "type": "float"}, {"doc": "Position angle from the triggering source to the object, East of North [deg]", "name": "pa", "type": "float"}, {"doc": "Predicted V-band magnitude from MPC H/G photometric parameters; null when the object has no catalogued H [mag]", "default": null, "name": "predVMag", "type": ["null", "float"]}]}}]}, {"doc": "Nearest star-classified reference-catalog sources (max 3, nearest first) within REF_MATCH_RADIUS_ARCSEC of the triggering source; null if matching was not run (catalog unavailable), empty if none within the radius; a full array (3) means the neighborhood may extend beyond what is reported (crowding)", "default": null, "name": "refStarMatches", "type": ["null", {"type": "array", "items": {"version": "00.05", "type": "record", "doc": "Reference-image catalog source near the triggering source", "name": "rapid.v00_05.refMatch", "fields": [{"doc": "SExtractor NUMBER of the reference source, unique within this field's mosaic catalog", "name": "sourceId", "type": "string"}, {"doc": "Right ascension of the reference source; ICRS [deg]", "name": "ra", "type": "double"}, {"doc": "Declination of the reference source; ICRS [deg]", "name": "dec", "type": "double"}, {"doc": "Angular separation from the triggering source position [arcsec]", "name": "sep", "type": "float"}, {"doc": "Position angle from the triggering source to the reference source, East of North [deg]", "name": "pa", "type": "float"}, {"doc": "SExtractor CLASS_STAR star/galaxy score (1 = point-like); the star/galaxy array split uses providers.REFCAT_STAR_MIN_CLASS, recorded here so consumers can re-cut", "name": "classStar", "type": "float"}, {"doc": "SExtractor extraction FLAGS bitmask of the reference source (2 = blended, 4 = saturated, ...)", "name": "flags", "type": "int"}, {"doc": "Kron-like automatic-aperture magnitude MAG_AUTO (instrumental; nJy calibration pending); null when the measurement failed [mag]", "default": null, "name": "magAuto", "type": ["null", "float"]}, {"doc": "Uncertainty in magAuto; null with magAuto [mag]", "default": null, "name": "magErrAuto", "type": ["null", "float"]}, {"doc": "SExtractor ELONGATION (major/minor axis ratio)", "default": null, "name": "elong", "type": ["null", "float"]}, {"doc": "FWHM assuming a Gaussian core (FWHM_IMAGE) [arcsec]", "default": null, "name": "fwhm", "type": ["null", "float"]}, {"doc": "Radius enclosing half of the source flux (FLUX_RADIUS at fraction 0.5); with magAuto, supports size-normalized host separations [arcsec]", "default": null, "name": "halfLightRadius", "type": ["null", "float"]}, {"doc": "Kron aperture scale factor (KRON_RADIUS, dimensionless; multiplies the profile's A_IMAGE per SExtractor convention)", "default": null, "name": "kronRadius", "type": ["null", "float"]}]}}]}, {"doc": "Nearest galaxy-classified reference-catalog sources (max 3, nearest first) within REF_MATCH_RADIUS_ARCSEC of the triggering source; null/empty semantics as refStarMatches", "default": null, "name": "refGalaxyMatches", "type": ["null", {"type": "array", "items": "rapid.v00_05.refMatch"}]}, {"doc": "Nearest NED candidate host galaxies (max 3, nearest first) within NED_MATCH_RADIUS_ARCSEC of the triggering source; null if matching was not run (disabled, or NED unavailable/unreachable), empty if none within the radius; a full array (3) means the neighborhood may extend beyond what is reported. Restricted to host candidates by providers.select_host_candidates -- an unrestricted NED match is ~98% non-galaxy at this depth", "default": null, "name": "nedMatches", "type": ["null", {"type": "array", "items": {"version": "00.05", "type": "record", "doc": "NED candidate host galaxy near the triggering source", "name": "rapid.v00_05.nedMatch", "fields": [{"doc": "NED preferred object name; the key for any NED lookup (NED has no stable numeric object id in this product)", "name": "prefName", "type": "string"}, {"doc": "Right ascension of the NED object; ICRS [deg]", "name": "ra", "type": "double"}, {"doc": "Declination of the NED object; ICRS [deg]", "name": "dec", "type": "double"}, {"doc": "Angular separation from the triggering source position [arcsec]", "name": "sep", "type": "float"}, {"doc": "Position angle from the triggering source to the NED object, East of North [deg]", "name": "pa", "type": "float"}, {"doc": "NED preferred object type (G, GPair, QSO, ...); null when NED has not classified the entry. The host-candidate selection applied at match time is providers.select_host_candidates, recorded here so consumers can re-cut", "default": null, "name": "type", "type": ["null", "string"]}, {"doc": "NED preferred redshift; null when NED has none. Frame is as published (assumed heliocentric, not CMB-corrected -- NED does not document this); check zFlag before using", "default": null, "name": "z", "type": ["null", "float"]}, {"doc": "Uncertainty in z; null when NED gives none", "default": null, "name": "zUnc", "type": ["null", "float"]}, {"doc": "NED redshift code: technique (S = spectroscopic, P = photometric, M = modelled) + 2-char method + optional '?' (uncertain), e.g. 'SLS'. Require zFlag[0] == 'S' for a secure host redshift; without this z is not interpretable", "default": null, "name": "zFlag", "type": ["null", "string"]}]}}]}, {"doc": "Nearest NED-LVS galaxies (max 3, nearest first) within LVS_MATCH_RADIUS_ARCSEC (30 arcsec) of the triggering source -- NED's vetted local-volume sample (D < 1000 Mpc) with distances, angular diameters, photometry, SFR and stellar mass; null if matching was not run (disabled, or the table unavailable), empty if none within the radius; a full array (3) means the neighborhood may extend beyond what is reported. Joins to nedMatches by prefName", "default": null, "name": "lvsMatches", "type": ["null", {"type": "array", "items": {"version": "00.05", "type": "record", "doc": "NED-LVS local-volume galaxy near the triggering source", "name": "rapid.v00_05.lvsMatch", "fields": [{"doc": "NED preferred object name (NED-LVS objname); the same name as nedMatch.prefName, so the two arrays join by it", "name": "prefName", "type": "string"}, {"doc": "Right ascension of the galaxy; ICRS [deg]", "name": "ra", "type": "double"}, {"doc": "Declination of the galaxy; ICRS [deg]", "name": "dec", "type": "double"}, {"doc": "Angular separation from the triggering source position [arcsec]", "name": "sep", "type": "float"}, {"doc": "Position angle from the triggering source to the galaxy, East of North [deg]", "name": "pa", "type": "float"}, {"doc": "NED preferred object type (G, GPair, ...)", "default": null, "name": "objType", "type": ["null", "string"]}, {"doc": "NED-LVS fiducial redshift, heliocentric; null when none", "default": null, "name": "z", "type": ["null", "float"]}, {"doc": "Uncertainty in z; null when unpublished", "default": null, "name": "zUnc", "type": ["null", "float"]}, {"doc": "How z was measured: SPEC, PHOT, UNKN, INFD (inferred) or MOD (modelled); the redshift-quality handle", "default": null, "name": "zTech", "type": ["null", "string"]}, {"doc": "NED-LVS redshift quality flag: True = flagged UNRELIABLE (NED-LVS polarity, kept as published)", "name": "zQual", "type": "boolean"}, {"doc": "The distance NED-LVS adopts for this galaxy [Mpc]", "default": null, "name": "distMpc", "type": ["null", "float"]}, {"doc": "Uncertainty in distMpc [Mpc]", "default": null, "name": "distMpcUnc", "type": ["null", "float"]}, {"doc": "Which measurement distMpc came from: 'Redshift' (from z; 99% of galaxies) or 'zIndependent' (a NED-D measurement -- Cepheids, TRGB, SNe Ia, ...; distMpc is then that value)", "default": null, "name": "distMethod", "type": ["null", "string"]}, {"doc": "Angular major-axis diameter 2a; null when NED-LVS has no fiducial diameter (~19% of galaxies) [arcsec]", "default": null, "name": "diam", "type": ["null", "float"]}, {"doc": "Minor-to-major axis ratio of the diameter ellipse", "default": null, "name": "diamBA", "type": ["null", "float"]}, {"doc": "Position angle of the diameter ellipse, East of North [deg]", "default": null, "name": "diamPA", "type": ["null", "float"]}, {"doc": "NED-LVS diameter quality flag: True = flagged HIGHLY UNCERTAIN (NED-LVS polarity, kept as published)", "name": "diamQual", "type": "boolean"}, {"doc": "Foreground Milky Way reddening E(B-V), Schlafly & Finkbeiner 2011 [mag]", "default": null, "name": "ebv", "type": ["null", "float"]}, {"doc": "2MASS Ks apparent magnitude, Vega system [mag]", "default": null, "name": "magKs", "type": ["null", "float"]}, {"doc": "Uncertainty in magKs [mag]", "default": null, "name": "magKsUnc", "type": ["null", "float"]}, {"doc": "WISE W1 apparent magnitude, Vega system [mag]", "default": null, "name": "magW1", "type": ["null", "float"]}, {"doc": "Uncertainty in magW1 [mag]", "default": null, "name": "magW1Unc", "type": ["null", "float"]}, {"doc": "GALEX NUV apparent magnitude, AB system [mag]", "default": null, "name": "magNUV", "type": ["null", "float"]}, {"doc": "Uncertainty in magNUV [mag]", "default": null, "name": "magNUVUnc", "type": ["null", "float"]}, {"doc": "Star-formation rate from the FUV+W4 hybrid scaling relation [Msun/yr]", "default": null, "name": "sfr", "type": ["null", "double"]}, {"doc": "Uncertainty in sfr [Msun/yr]", "default": null, "name": "sfrUnc", "type": ["null", "double"]}, {"doc": "Stellar mass from the W1 luminosity scaling relation [Msun]", "default": null, "name": "mStar", "type": ["null", "double"]}, {"doc": "Uncertainty in mStar [Msun]", "default": null, "name": "mStarUnc", "type": ["null", "double"]}]}}]}, {"doc": "FITS cutout of difference image", "default": null, "name": "cutoutDifference", "type": ["null", "bytes"]}, {"doc": "FITS cutout of science image", "default": null, "name": "cutoutScience", "type": ["null", "bytes"]}, {"doc": "FITS cutout of reference image", "default": null, "name": "cutoutReference", "type": ["null", "bytes"]}, {"doc": "Reason for observation (e.g. survey, ToO)", "default": null, "name": "observation_reason", "type": ["null", "string"]}, {"doc": "Target name if targeted observation", "default": null, "name": "target_name", "type": ["null", "string"]}]}␀¼™}WÚ’^<=3.1¯’µì½y<UëûÿÏM4 4‰4’)Û¸{­½±i’D“9IfÍÉL‰Jš¤4ª4†}_›&©¤Ò$ÍóDƒ&I¿{­Î±·÷9ïÏqúúç÷x¼×9I{]ëº_×pÔÉĞĞÀĞT&UT~HŸıP¹¯“JEí÷7«Ÿ6ÔÉVä”9¤QËG¹óÑ%ÍwoùèÑÕX›üq9z—rCùû¿+İõÔZ|n§“peßvÈÙa³ûAFu˜Ä11CãísìQ´æ£ëQ“„²2¿.TûZ‰Fº½×Z£é…¨T-É2§Q¹\wÅyì²BI´ğÿù"FÉçH&ÿr|q©\föCYœ ûç?Ë TÙİÛréä×u”z‚+ox©^Ë—aÉªi1ävíµ;î&äN«œ„»ûòú«,Q¯W¸Íä
