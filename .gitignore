# Gitignore file for the RAPID repository

# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]

# uv scratch: the test suite is sometimes run through `uv run --with pytest`,
# which synthesises these for that ephemeral harness. They are not this
# repo's dependency resolution and must not be committed (the pre-push scan
# also reads their hash fragments as AWS account ids).
uv.lock
.venv/

# C build outputs (c/builds/build*.csh build in-tree into these; the
# scripts themselves under c/builds/ are tracked)
c/bin/
c/lib/
c/include/
*.o
*.a
*.so

# Pipeline scratch / working area
work/

# Docs build output
docs/build/
docs/**/*.inc

# Editor / local config
.vscode/

# Secrets — never commit
*.env

# Personal scratch notes
alerts/scratch/
