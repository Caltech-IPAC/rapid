{
    "namespace": "rapid.v00_08",
    "name": "diaForcedSource",
    "doc": "Forced photometry measurement at a diaObject position",
    "version": "00.08",
    "type": "record",
    "fields": [
        {
            "name": "diaForcedSourceId",
            "type": "long",
            "doc": "Unique identifier for this forced source measurement"
        },
        {
            "name": "diaObjectId",
            "type": "long",
            "doc": "Associated diaObject identifier"
        },
        {
            "name": "expId",
            "type": "long",
            "doc": "RAPID-assigned exposure identifier"
        },
        {
            "name": "detector",
            "type": "int",
            "doc": "Detector (SCA) number"
        },
        {
            "name": "ra",
            "type": "double",
            "doc": "Right ascension of forced measurement position; ICRS [deg]"
        },
        {
            "name": "dec",
            "type": "double",
            "doc": "Declination of forced measurement position; ICRS [deg]"
        },
        {
            "name": "band",
            "type": [
                "null",
                "string"
            ],
            "default": null,
            "doc": "Filter band name"
        },
        {
            "name": "psfFlux",
            "type": [
                "null",
                "float"
            ],
            "default": null,
            "doc": "Forced PSF flux on difference image [nJy]"
        },
        {
            "name": "psfFluxErr",
            "type": [
                "null",
                "float"
            ],
            "default": null,
            "doc": "Uncertainty in psfFlux [nJy]"
        },
        {
            "name": "scienceFlux",
            "type": [
                "null",
                "float"
            ],
            "default": null,
            "doc": "Forced PSF flux on science image (stub) [nJy]"
        },
        {
            "name": "scienceFluxErr",
            "type": [
                "null",
                "float"
            ],
            "default": null,
            "doc": "Uncertainty in scienceFlux (stub) [nJy]"
        },
        {
            "name": "zeroPoint",
            "type": [
                "null",
                "float"
            ],
            "default": null,
            "doc": "AB zero point of the image the fluxes were measured on: the magnitude of 1 DN/s [mag]"
        },
        {
            "name": "pixelAreaFactor",
            "type": [
                "null",
                "float"
            ],
            "default": null,
            "doc": "Pixel area map value at the measured position, a factor in the fluxes; null when the image has no map"
        },
        {
            "name": "midpointMjd",
            "type": "double",
            "doc": "Effective mid-observation time: the exposure start plus half the exposure time (UTC scale) [MJD]"
        },
        {
            "name": "timeProcessedMjd",
            "type": "double",
            "doc": "Time measurement was processed (UTC scale) [MJD]"
        }
    ]
}
